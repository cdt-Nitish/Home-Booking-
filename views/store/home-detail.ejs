<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <div class="page-wrapper">
      <div class="container">

        <!-- Hero Image -->
        <div class="detail-hero">
          <img
            src="<%= home.image %>"
            alt="<%= home.houseName %>"
            onerror="this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=1200&q=80'"
          />
        </div>

        <div class="detail-grid">

          <!-- Left: Info -->
          <div class="detail-info">
            <h1><%= home.houseName %></h1>

            <div class="detail-chips">
              <span class="detail-chip">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                <%= home.location %>
              </span>
              <span class="detail-chip">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <%= home.rating %> / 5
              </span>
            </div>

            <div class="detail-section">
              <h3>About this place</h3>
              <p><%= home.description || 'No description provided yet.' %></p>
            </div>

            <div class="detail-section">
              <h3>Location</h3>
              <p><%= home.location %></p>
            </div>

            <div class="detail-section">
              <h3>Rating</h3>
              <div style="display:flex; align-items:center; gap: 0.5rem;">
                <% for(let i = 1; i <= 5; i++) { %>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="<%= i <= Math.round(home.rating) ? '#FF385C' : '#DDDDDD' %>" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <% } %>
                <span style="color: var(--text-secondary); font-size: 0.9rem;"><%= home.rating %> out of 5</span>
              </div>
            </div>

            <div class="detail-section" style="border-bottom: none;">
              <%- include('../partials/favourite', {home: home}) %>
            </div>
          </div>

          <!-- Right: Booking panel -->
          <aside class="booking-panel" aria-label="Booking details">
            <div class="price-line">
              ₹<%= home.price %> <span>/ night</span>
            </div>

            <div style="background: var(--surface-2); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1.25rem; font-size: 0.875rem; color: var(--text-secondary);">
              <div style="display:flex; justify-content:space-between; margin-bottom: 0.5rem;">
                <span>₹<%= home.price %> × 1 night</span>
                <span>₹<%= home.price %></span>
              </div>
              <div style="display:flex; justify-content:space-between; padding-top: 0.75rem; border-top: 1px solid var(--border); font-weight: 700; color: var(--text-primary);">
                <span>Total</span>
                <span>₹<%= home.price %></span>
              </div>
            </div>

            <div class="mt-4, mb-4">
              <a href="/rules/<%= home._id %>" class="btn btn-outline btn-full" style="font-size: 1rem; padding: 1rem; background-color: var(--surface-2);">
                View House Rules
              </a>
            </div>

            <form action="/bookings" method="POST">
              <input type="hidden" name="homeId" value="<%= home._id %>" />
              <button type="submit" class="btn btn-primary btn-full" style="font-size: 1rem; padding: 1rem;">
                Reserve Now
              </button>
            </form>

            <p style="text-align:center; margin-top: 0.75rem; font-size: 0.78rem; color: var(--text-muted);">You won't be charged yet</p>
          </aside>

        </div>

      </div>
    </div>
  </body>
</html>
