<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <div class="page-wrapper">
      <div class="container">

        <div class="page-header">
          <h1>❤️ Saved Homes</h1>
          <p>Your favourite places, all in one spot</p>
        </div>

        <% if(favouriteHomes && favouriteHomes.length > 0) { %>
          <div class="homes-grid">
            <% favouriteHomes.forEach(home => { %>
              <article class="property-card">
                <div class="property-card__image-wrap">
                  <img
                    src="<%= home.image %>"
                    alt="<%= home.houseName %>"
                    loading="lazy"
                    onerror="this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=600&q=80'"
                  />
                  <span class="property-card__badge">Saved</span>
                </div>
                <div class="property-card__body">
                  <h3 class="property-card__name"><%= home.houseName %></h3>
                  <p class="property-card__location">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    <%= home.location %>
                  </p>
                  <div class="property-card__meta">
                    <div class="property-card__price">
                      ₹<%= home.price %> <span>/ night</span>
                    </div>
                    <div class="property-card__rating">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      <%= home.rating %>
                    </div>
                  </div>
                </div>
                <div class="property-card__actions">
                  <a href="/homes/<%= home._id %>" class="btn btn-secondary" style="flex:1; text-align:center;">View</a>
                  <form action="/favourites/delete/<%= home._id %>" method="POST" style="margin:0;">
                    <button type="submit" class="btn btn-danger" title="Remove from saved">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                      Remove
                    </button>
                  </form>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-state__icon">💔</div>
            <h3>No saved homes yet</h3>
            <p>Browse our listings and tap the heart to save homes you love.</p>
            <a href="/homes" class="btn btn-primary">Browse Homes</a>
          </div>
        <% } %>

      </div>
    </div>
  </body>
</html>
