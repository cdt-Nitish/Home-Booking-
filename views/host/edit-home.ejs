<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <div class="page-wrapper">
      <div class="container">
        <div class="form-card">

          <div class="form-card-header">
            <div style="display:flex; align-items:center; gap: 0.75rem; margin-bottom: 0.75rem;">
              <div style="width:40px; height:40px; background: linear-gradient(135deg, var(--brand), var(--brand-dark)); border-radius: 10px; display:flex; align-items:center; justify-content:center; color:#fff; font-size: 1.25rem;">
                <%= editing ? '✏️' : '🏠' %>
              </div>
              <h1><%= editing ? "Edit Listing" : "Add New Listing" %></h1>
            </div>
            <p><%= editing ? "Update your property details below." : "Fill in the details to list your property on Airbnb." %></p>
          </div>

          <form action="/host/<%= editing ? 'edit-home' : 'add-home' %>" method="POST" novalidate enctype="multipart/form-data"
>
            <input type="hidden" name="id" value="<%= editing ? home._id : '' %>" />

            <div class="form-group">
              <label for="houseName">Property Name</label>
              <input
                id="houseName"
                type="text"
                name="houseName"
                value="<%= editing ? home.houseName : '' %>"
                placeholder="e.g. Cozy Mountain Cabin"
                required
              />
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
              <div class="form-group">
                <label for="price">Price per Night (₹)</label>
                <input
                  id="price"
                  type="number"
                  name="price"
                  value="<%= editing ? home.price : '' %>"
                  placeholder="2500"
                  min="0"
                  required
                />
              </div>
              <div class="form-group">
                <label for="rating">Rating (1–5)</label>
                <input
                  id="rating"
                  type="number"
                  name="rating"
                  value="<%= editing ? home.rating : '' %>"
                  placeholder="4.5"
                  min="1"
                  max="5"
                  step="0.1"
                />
              </div>
            </div>

            <div class="form-group">
              <label for="location">Location</label>
              <input
                id="location"
                type="text"
                name="location"
                value="<%= editing ? home.location : '' %>"
                placeholder="e.g. Manali, Himachal Pradesh"
                required
              />
            </div>

            <div class="form-group">
              <label for="image">Image URL</label>
              <input
                id="image"
                type="file"
                name="image"
                accept="image/jpg, image/png, image/png"
                value="<%= editing ? home.image : '' %>"
                
              />
            </div>

            <div class="form-group">
              <label for="description">Description</label>
              <textarea
                id="description"
                name="description"
                placeholder="Describe your property — amenities, nearby attractions, house rules…"
                rows="4"
              ><%= editing ? home.description : '' %></textarea>
            </div>

            <div style="display:flex; gap: 0.75rem; margin-top: 0.5rem;">
              <a href="/host/host-home-list" class="btn btn-secondary" style="flex:1; text-align:center;">Cancel</a>
              <button type="submit" class="btn btn-primary" style="flex:2;">
                <%= editing ? "Save Changes" : "Publish Listing" %> &nbsp;→
              </button>
            </div>

          </form>
        </div>
      </div>
    </div>
  </body>
</html>
