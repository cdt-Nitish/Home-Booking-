<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="alert alert-danger  bg-red-300"  role="alert">
            <ul
              style="list-style-type: dotted; padding-left: 10px; margin: 10px 0; color: #df3434; font-weight: 400;"
            >
              <% errors.forEach(function(error) { %>
                <li><%= error %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>